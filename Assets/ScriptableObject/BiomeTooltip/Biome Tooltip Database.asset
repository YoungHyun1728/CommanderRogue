  entries:
  - biome: 0
    description: "\uACE0\uBE14\uB9B0\uACFC \uC624\uD06C\uC758 \uCD9C\uBAB0\uC774
      \uC7A6\uC740 \n\uC9C0\uC5ED"
    effect: "\uD2B9\uC218\uD6A8\uACFC\n\uC804\uD22C\uAC00 \uB05D\uB0A0 \uB54C \uB9C8\uB2E4
      \uCCB4\uB825 20%\uC744 \uD68C\uBCF5\uD569\uB2C8\uB2E4."
  - biome: 1
    description: "\uACBD\uBE44\uB300\uAC00 \uC21C\uCC30 \uC911 \uC785\uB2C8\uB2E4.\n\uC2E0\uBD84\uC99D\uC744
      \uC81C\uC2DC\uD558\uC138\uC694.\n\uC2E0\uBD84\uC99D\uC774 \uC788\uB2E4\uBA74\uC694."
    effect: "\uD2B9\uC218\uD6A8\uACFC\n\uC804\uD22C \uC2DC\uC791 \uC2DC 5\uCD08\uAC04
      \uACF5\uACA9\uC18D\uB3C4\uAC00\n30%\uB9CC\uD07C \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - biome: 2
    description: "\uC5D8\uD504\uB4E4\uC774 \uC0AC\uB294 \uAE4A\uC740 \uC232\uC18D\n\uACBD\uACC4\uC2EC\uC774
      \uB9CE\uC740 \uC885\uC871\uC785\uB2C8\uB2E4."
    effect: "\uD2B9\uC218\uD6A8\uACFC\n\uBAA8\uB4E0 \uCE90\uB9AD\uD130\uC758 \uB9C8\uB098
      \uC7AC\uC0DD\uC774 2\uB9CC\uD07C \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - biome: 3
    description: "\uD1B5\uD589\uC5D0 \uBD88\uD3B8\uC744 \uB4DC\uB824 \n\uB300\uB2E8\uD788
      \uC8C4\uC1A1\uD569\uB2C8\uB2E4.\n- \uB8EC\uB9C8\uC774\uB2DD -"
    effect: "\uD2B9\uC218\uD6A8\uACFC\n\uBAA8\uB4E0 \uCE90\uB9AD\uD130\uC758 \uACF5\uACA9\uBC94\uC704\uAC00
      1 \uB9CC\uD07C \n\uD558\uB77D\uD569\uB2C8\uB2E4."
  - biome: 4
    description: "\uC6A9\uC0AC\uD30C\uD2F0\uAC00 \uC218\uBC30\uC911\uC778 \uB3C4\uC801\uB2E8\uC744
      \uCC3E\uACE0\uC788\uC2B5\uB2C8\uB2E4."
    effect: "\uD2B9\uC218\uD6A8\uACFC\n\uC804\uD22C \uC2DC\uC791 \uC2DC \uBAA8\uB4E0
      \uCE90\uB9AD\uD130\uC758 \uB9C8\uB098\uAC00\n100\uB9CC\uD07C \uD68C\uBCF5\uB429\uB2C8\uB2E4."
  - biome: 5
    description: "\uC804\uD22C \uC911\uC5D0 \uBAA9\uC228\uC744 \uC783\uB294\uAC8C
      \uC601\uAD11\uC778\n\uC11C\uB9AC\uC774\uBE68\uBD80\uC871\uC774 \uC0AC\uB294
      \uC9C0\uC5ED"
    effect: "\uD2B9\uC218\uD6A8\uACFC\n\uC804\uD22C \uC2DC\uC791 \uC2DC 5\uCD08\uAC04
      \uACF5\uACA9\uC18D\uB3C4\uAC00\n30%\uB9CC\uD07C \uAC10\uC18C\uD569\uB2C8\uB2E4."
  - biome: 6
    description: "\uD0DC\uC591\uC11D\uC744 \uC218\uD638\uD558\uB294 \uBC31\uC57C\uAD50\uAC00\n\uAD00\uB9AC\uD558\uB294
      \uC9C0\uC5ED"
    effect: "\uD2B9\uC218\uD6A8\uACFC\n\uC804\uD22C \uC2DC\uC791 \uC2DC 5\uCD08\uAC04
      \uBC1B\uB294 \uD53C\uD574\uAC00 30%\uB9CC\uD07C \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - biome: 7
    description: "\uC815\uBCF4\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.\n"
    effect: "\uD2B9\uC218\uD6A8\uACFC\n\uCE90\uB9AD\uD130\uB4E4\uC758 \uCD5C\uB300
      \uB9C8\uB098\uAC00 50 \uB9CC\uD07C\n\uC99D\uAC00\uD569\uB2C8\uB2E4."
